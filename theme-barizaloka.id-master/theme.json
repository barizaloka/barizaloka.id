{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "color": {
            "defaultPalette": false,
            "palette": [
                { "name": "Hijau Primer",    "slug": "bzk-green",       "color": "#1D9E75" },
                { "name": "Hijau Gelap",     "slug": "bzk-green-dark",  "color": "#0D5C46" },
                { "name": "Hijau Tengah",    "slug": "bzk-green-mid",   "color": "#0F6E56" },
                { "name": "Hijau Muda",      "slug": "bzk-green-light", "color": "#E1F5EE" },
                { "name": "Hijau Pale",      "slug": "bzk-green-pale",  "color": "#9FE1CB" },
                { "name": "Aksen Biru",      "slug": "bzk-accent",      "color": "#378ADD" },
                { "name": "Amber",           "slug": "bzk-amber",       "color": "#B7791F" },
                { "name": "Amber Muda",      "slug": "bzk-amber-light", "color": "#FEF9E7" },
                { "name": "Teks Utama",      "slug": "bzk-text",        "color": "#1a1a1a" },
                { "name": "Teks Muted",      "slug": "bzk-muted",       "color": "#555555" },
                { "name": "Teks Light",      "slug": "bzk-light",       "color": "#888888" },
                { "name": "Putih",           "slug": "white",           "color": "#ffffff" },
                { "name": "Background",      "slug": "bzk-bg",          "color": "#f7f9f8" },
                { "name": "Border",          "slug": "bzk-border",      "color": "#e0e0e0" }
            ],
            "gradients": [
                {
                    "name": "Hijau Hero",
                    "slug": "bzk-hero-gradient",
                    "gradient": "linear-gradient(135deg, #0D5C46 0%, #1D9E75 50%, #5DCAA5 100%)"
                },
                {
                    "name": "Hijau Lembut",
                    "slug": "bzk-soft-gradient",
                    "gradient": "linear-gradient(135deg, #E1F5EE 0%, #9FE1CB 100%)"
                }
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "name": "Plus Jakarta Sans",
                    "slug": "plus-jakarta",
                    "fontFamily": "'Plus Jakarta Sans', 'Segoe UI', system-ui, sans-serif"
                },
                {
                    "name": "System UI",
                    "slug": "system-ui",
                    "fontFamily": "system-ui, -apple-system, sans-serif"
                }
            ],
            "fontSizes": [
                { "name": "Kecil",  "slug": "small",  "size": "0.813rem" },
                { "name": "Normal", "slug": "normal", "size": "1rem"     },
                { "name": "Sedang", "slug": "medium", "size": "1.25rem"  },
                { "name": "Besar",  "slug": "large",  "size": "1.75rem"  },
                { "name": "Jumbo",  "slug": "huge",   "size": "2.5rem"   }
            ],
            "defaultFontSizes": false,
            "fluid": true
        },
        "spacing": {
            "spacingScale": {
                "steps": 7,
                "mediumStep": 1.5,
                "unit": "rem",
                "operator": "*",
                "increment": 1.5,
                "type": "linear"
            },
            "customSpacingSize": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "layout": {
            "contentSize": "760px",
            "wideSize": "1080px"
        },
        "custom": {
            "spacing": {
                "small":  "clamp(1.5rem, 5vw, 2rem)",
                "medium": "clamp(2rem, 8vw, 4rem)",
                "large":  "clamp(4rem, 10vw, 6rem)"
            },
            "lineHeight": {
                "tiny":   "1.2",
                "small":  "1.4",
                "medium": "1.65",
                "large":  "1.8"
            }
        }
    },
    "styles": {
        "color": {
            "background": "#f7f9f8",
            "text": "#1a1a1a"
        },
        "typography": {
            "fontFamily": "var:preset|font-family|plus-jakarta",
            "fontSize": "var:preset|font-size|normal",
            "lineHeight": "1.7"
        },
        "elements": {
            "link": {
                "color": { "text": "#1D9E75" },
                ":hover": {
                    "color": { "text": "#0F6E56" }
                }
            },
            "h1": { "typography": { "fontSize": "clamp(1.75rem, 4vw, 2.5rem)", "fontWeight": "600", "lineHeight": "1.25" } },
            "h2": { "typography": { "fontSize": "clamp(1.4rem, 3vw, 2rem)",    "fontWeight": "600", "lineHeight": "1.3"  } },
            "h3": { "typography": { "fontSize": "1.15rem", "fontWeight": "600" } },
            "h4": { "typography": { "fontSize": "1rem",    "fontWeight": "600" } },
            "button": {
                "color": {
                    "background": "#1D9E75",
                    "text": "#ffffff"
                },
                "border": {
                    "radius": "10px"
                },
                "typography": {
                    "fontWeight": "500",
                    "fontSize": "0.9rem"
                },
                ":hover": {
                    "color": { "background": "#0F6E56" }
                }
            }
        },
        "blocks": {
            "core/group": {
                "spacing": {
                    "padding": { "top": "2rem", "bottom": "2rem", "left": "1.5rem", "right": "1.5rem" }
                }
            },
            "core/paragraph": {
                "typography": {
                    "lineHeight": "1.7"
                }
            },
            "core/heading": {
                "typography": {
                    "lineHeight": "1.3"
                }
            }
        }
    }
}
